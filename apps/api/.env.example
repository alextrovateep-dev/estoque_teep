# =============================================================================
# TEEP Estoque — apps/api/.env.example
# =============================================================================
#
# COMO USAR
#   cp apps/api/.env.example apps/api/.env
#   Ajuste valores. Nunca commite apps/api/.env
#
# A API (Express/Prisma) carrega ESTE arquivo quando roda em apps/api.
# Front (Next): veja apps/web/.env.local.example
# Produção Docker: deploy/env.production.example → .env.production na raiz do VPS
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1) BANCO — Prisma / PostgreSQL (obrigatório)
# -----------------------------------------------------------------------------
# Dev embutido (`pnpm --filter @teep/api db:pg`): porta 5433
# Docker Compose: porta 5432 (host) / host `postgres` dentro da rede
DATABASE_URL=postgresql://teep:teep@127.0.0.1:5433/estoque_teep?schema=public


# -----------------------------------------------------------------------------
# 2) REDIS — fila de e-mail (opcional em dev)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Sem Redis local:
REDIS_DISABLED=1


# -----------------------------------------------------------------------------
# 3) JWT — login / sessão (obrigatório)
# -----------------------------------------------------------------------------
# Em production: ≥32 chars aleatórios, sem "change-me"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Cookie HttpOnly do refresh (Path=/auth). Em production: SameSite=None + Secure.
# Dev (localhost): Lax automático. Override opcional:
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_SECURE=0


# -----------------------------------------------------------------------------
# 4) API HTTP
# -----------------------------------------------------------------------------
API_PORT=4000
# Origem do Next (CORS + Socket.io)
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# TRUST_PROXY=1
# JSON_BODY_LIMIT=1mb


# -----------------------------------------------------------------------------
# 5) SEED — `pnpm --filter @teep/api db:seed`
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@teep.com.br
SEED_ADMIN_PASSWORD=Admin@123
# SEED_OPS_PASSWORD=Oper@123
# SEED_DEMO=1
# Com SEED_DEMO=1 também cria estoques de exemplo (PLN/TBO/RMA/DESC) e usuários de homologação.
# Sem SEED_DEMO: só admin + tipos/categorias — estoques nascem no cadastro (Admin → Estoques).


# -----------------------------------------------------------------------------
# 6) E-MAIL (F9 / senha provisória)
# -----------------------------------------------------------------------------
# Sem SMTP_HOST → só log [email:dev]
# Destinatário = Usuario.email no banco (não um e-mail fixo aqui)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Produção (.env.production + Compose): $ na senha → escape $$ (senão trunca a senha).
# SMTP_SECURE=0
# EMAIL_FROM_TRANSACTIONAL=TEEP Estoque <noreply@seudominio.com.br>
# EMAIL_REPLY_TO=suporte@seudominio.com.br
# EMAIL_SUPPORT=suporte@seudominio.com.br
# FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 7) UPLOADS (F13)
# -----------------------------------------------------------------------------
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_BYTES=10485760


# -----------------------------------------------------------------------------
# 8) ASSISTENTE LLM no Dashboard (F14)
# -----------------------------------------------------------------------------
# ASSISTENTE_LLM_ENABLED=1
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOOL_ROUNDS=3
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800


# -----------------------------------------------------------------------------
# 9) PDF (Puppeteer) — exportação de saldos no Dashboard
# -----------------------------------------------------------------------------
# Em Docker Alpine a imagem já define /usr/bin/chromium.
# Em Windows/macOS local, deixe em branco (detecta Chrome/Edge) ou aponte:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=
# Timeout do PDF (ms) — padrão 45000
# PDF_TIMEOUT_MS=45000


# -----------------------------------------------------------------------------
# 10) SMOKE
# -----------------------------------------------------------------------------
# API_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# 11) RMA — defaults de filiais (Fase D, opcional)
# -----------------------------------------------------------------------------
# Sem estas vars: usa siglas RMA / DESC e todos os estoques operacionais na troca.
# UUIDs de filiais ativas (Admin → Estoques). Origens: lista separada por vírgula.
# RMA_FILIAL_PREPARACAO_ID=
# RMA_FILIAL_DESCARTE_ID=
# RMA_FILIAIS_ORIGEM_TROCA_IDS=


# -----------------------------------------------------------------------------
# 12) eGestor — pedidos de venda (somente leitura)
# -----------------------------------------------------------------------------
# Token pessoal (OAuth grant_type=personal). Sem token o sync não roda.
# EGESTOR_PERSONAL_TOKEN=
# EGESTOR_BASE_URL=https://v4.egestor.com.br/api
# EGESTOR_SYNC=0
# EGESTOR_SYNC_INTERVAL_MS=300000
# Só pedidos com dtCad ou dtVenda a partir desta data (padrão 2026-08-01)
# EGESTOR_SYNC_DT_INI=2026-08-01
