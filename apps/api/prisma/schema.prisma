generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Filial {
  id            String          @id @default(uuid()) @db.Uuid
  nome          String          @unique @db.VarChar(80)
  sigla         String          @unique @db.VarChar(5)
  cidade        String?         @db.VarChar(80)
  estado        String?         @db.Char(2)
  ativo         Boolean         @default(true)
  /// Pedidos de venda (eGestor) saem destes estoques
  estoqueAcabados Boolean       @default(false) @map("estoque_acabados")
  criadoEm      DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  usuarios      Usuario[]
  usuarioFiliais UsuarioFilial[]
  estoques      Estoque[]
  movimentacoes Movimentacao[] @relation("MovFilial")
  movimentacoesDestino Movimentacao[] @relation("MovFilialDestino")
  movimentacoesComponentes Movimentacao[] @relation("MovFilialComponentes")
  transferenciasOrigem  Transferencia[] @relation("Origem")
  transferenciasDestino Transferencia[] @relation("Destino")
  unidadesSerie         UnidadeSerie[]
  rmaProcessos          RmaProcesso[]
  pedidosVendaAcabado   PedidoVenda[]

  @@map("filiais")
}

model Usuario {
  id                 String         @id @default(uuid()) @db.Uuid
  nome               String         @db.VarChar(100)
  email              String         @unique @db.VarChar(100)
  senhaHash          String         @map("senha_hash") @db.VarChar(255)
  /// true = senha provisória; obriga troca no próximo acesso
  deveTrocarSenha    Boolean        @default(false) @map("deve_trocar_senha")
  perfil             String         @db.VarChar(30)
  /// Filial principal (padrão na UI / JWT); vínculo completo em UsuarioFilial
  filialId           String?        @map("filial_id") @db.Uuid
  ativo              Boolean        @default(true)
  /// Master switch: se false, nenhum e-mail de alerta
  receberAlertasEmail Boolean       @default(false) @map("receber_alertas_email")
  /// Quais eventos: { ESTOQUE_MINIMO, ESTOQUE_MAXIMO, PRECO_AJUSTADO, ... }
  alertasEmail       Json           @default("{}") @map("alertas_email")
  /// Overrides de acesso a telas/ações (ver PERMISSAO_KEYS no shared)
  permissoes         Json           @default("{}") @map("permissoes")
  /// Path relativo /uploads/fotos-perfil/...
  fotoPerfil         String?        @map("foto_perfil") @db.VarChar(255)
  /// Nome de exibição na plataforma (apelido)
  apelido            String?        @db.VarChar(80)
  telefone           String?        @db.VarChar(20)
  dataNascimento     DateTime?      @map("data_nascimento") @db.Date
  /// false = 1º acesso precisa completar perfil após senha
  perfilCompleto     Boolean        @default(false) @map("perfil_completo")
  criadoEm           DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  filial             Filial?        @relation(fields: [filialId], references: [id])
  filiaisVinculos    UsuarioFilial[]
  movimentacoes      Movimentacao[]
  refreshTokens      RefreshToken[]
  transferenciasCriadas Transferencia[]
  notificacoes       Notificacao[]
  rmaProcessosCriados RmaProcesso[] @relation("RmaCriadoPor")
  rmaComoComercial    RmaProcesso[] @relation("RmaResponsavelComercial")
  rmaItemAprovacoes   RmaItem[]     @relation("RmaItemAprovacaoPor")
  rmaDestinatarios     RmaDestinatario[]
  rmaChecklistExecucoes RmaChecklistExecucao[] @relation("RmaChecklistPreenchidoPor")
  rmaOrcamentosAprovados RmaOrcamento[] @relation("RmaOrcamentoAprovadoPor")
  clientesComoComercial Cliente[]
  serieAlocacoes      SerieAlocacao[]
  pedidosVendaSeparados PedidoVenda[] @relation("PedidoSeparadoPor")
  pedidosVendaDestinatarios PedidoVendaDestinatario[]

  @@map("usuarios")
}

model UsuarioFilial {
  usuarioId String  @map("usuario_id") @db.Uuid
  filialId  String  @map("filial_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  filial    Filial  @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@id([usuarioId, filialId])
  @@index([filialId])
  @@map("usuario_filiais")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  usuarioId String   @map("usuario_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Categoria {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String    @unique @db.VarChar(50)
  descricao String?   @db.Text
  ativo     Boolean   @default(true)
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id              String             @id @default(uuid()) @db.Uuid
  codigo          String             @unique @db.VarChar(50)
  descricao       String             @db.VarChar(150)
  categoriaId     String             @map("categoria_id") @db.Uuid
  unidade         String             @default("UN") @db.VarChar(10)
  precoUnitario   Decimal            @default(0.00) @map("preco_unitario") @db.Decimal(12, 2)
  /// 0 = sem alerta de mínimo
  estoqueMinimo   Int                @default(0) @map("estoque_minimo")
  /// 0 = sem alerta de máximo
  estoqueMaximo   Int                @default(0) @map("estoque_maximo")
  /// Paths relativos /uploads/conteudo/produtos/{id}/... (ordenados; 1ª = capa)
  fotos           Json               @default("[]")
  /// Se true, entradas/saídas/transferências exigem 1 série por unidade
  controlaSerie   Boolean            @default(false) @map("controla_serie")
  ativo           Boolean            @default(true)
  criadoEm        DateTime           @default(now()) @map("criado_em") @db.Timestamptz
  categoria       Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  estoques        Estoque[]
  movimentacoes   Movimentacao[]
  transferenciaItens TransferenciaItem[]
  unidadesSerie   UnidadeSerie[]
  contadoresSerie ContadorSerie[]
  configuracaoSerie ConfiguracaoSerie?
  serieAlocacoes  SerieAlocacao[]
  rmaItens        RmaItem[]
  componentesComoPai   ProdutoComponente[] @relation("BomPai")
  componentesComoFilho ProdutoComponente[] @relation("BomFilho")
  rmaChecklistTemplates RmaChecklistTemplate[]
  rmaManutencaoPecas    RmaManutencaoPeca[]
  rmaOrcamentoLinhas    RmaOrcamentoLinha[]
  pedidoVendaItens      PedidoVendaItem[]

  @@map("produtos")
}

model Cliente {
  id                      String         @id @default(uuid()) @db.Uuid
  nome                    String         @db.VarChar(150)
  nomeFantasia            String?        @map("nome_fantasia") @db.VarChar(120)
  documento               String?        @unique @db.VarChar(20)
  tipo                    String         @db.VarChar(15)
  email                   String?        @db.VarChar(100)
  telefone                String?        @db.VarChar(20)
  cep                     String?        @db.VarChar(9)
  logradouro              String?        @db.VarChar(120)
  numero                  String?        @db.VarChar(20)
  complemento             String?        @db.VarChar(80)
  bairro                  String?        @db.VarChar(80)
  cidade                  String?        @db.VarChar(50)
  estado                  String?        @db.Char(2)
  ativo                   Boolean        @default(true)
  /// Usuário comercial padrão para RMAs deste cliente
  responsavelComercialId  String?        @map("responsavel_comercial_id") @db.Uuid
  responsavelComercial    Usuario?       @relation(fields: [responsavelComercialId], references: [id], onDelete: SetNull)
  movimentacoes           Movimentacao[]
  unidadesSerie           UnidadeSerie[]
  rmaProcessos            RmaProcesso[]

  @@index([responsavelComercialId])
  @@map("clientes")
}

model TipoMovimentacao {
  id                 String              @id @default(uuid()) @db.Uuid
  nome               String              @unique @db.VarChar(50)
  /// ENTRADA | SAIDA | TRANSFERENCIA
  operacao           String              @db.VarChar(20)
  requerCliente      Boolean             @default(false) @map("requer_cliente")
  requerAprovacao    Boolean             @default(false) @map("requer_aprovacao")
  /// Pode aparecer no Novo Lançamento para OPERADOR
  permitidoOperador  Boolean             @default(false) @map("permitido_operador")
  /// Pode aparecer no Novo Lançamento para GERENTE/ADMIN
  permitidoGerente   Boolean             @default(true) @map("permitido_gerente")
  sistema            Boolean             @default(false)
  /// Ao lançar saída: agenda alertas de retorno (e-mail + inbox)
  geraAlertaRetorno  Boolean             @default(false) @map("gera_alerta_retorno")
  /// Dias após dataMovimento para disparar (ex. [15,30,45,60])
  diasAlerta         Json                @default("[15,30,45,60]") @map("dias_alerta")
  /// Se preenchido, este tipo é retorno do tipo origem (picker de saídas abertas)
  ehRetornoDeId      String?             @map("eh_retorno_de_id") @db.Uuid
  /// Exige anexo TERMO_COMODATO no lançamento (ex. Saída Comodato)
  requerTermoComodato Boolean            @default(false) @map("requer_termo_comodato")
  /// SAIDA/TRANSFERENCIA: na saída baixa componentes não-fantasma da BOM
  baixaPorArvore     Boolean             @default(false) @map("baixa_por_arvore")
  /// ENTRADA usada pelo RMA ao abrir processo / incluir item (gera estoque automático)
  rmaEntradaEstoque  Boolean             @default(false) @map("rma_entrada_estoque")
  /// SAIDA usada pelo RMA em devolver/trocar
  rmaSaidaCliente    Boolean             @default(false) @map("rma_saida_cliente")
  /// SAIDA usada na separação de pedidos eGestor (no máximo um ativo)
  saidaPedidoVenda   Boolean             @default(false) @map("saida_pedido_venda")
  descricao          String?             @db.Text
  ativo              Boolean             @default(true)
  movimentacoes      Movimentacao[]
  alertas            ConfiguracaoAlerta[]
  ehRetornoDe        TipoMovimentacao?   @relation("TipoRetorno", fields: [ehRetornoDeId], references: [id], onDelete: SetNull)
  retornosComoOrigem TipoMovimentacao[]  @relation("TipoRetorno")

  @@index([ehRetornoDeId])
  /// No máximo um tipo ativo com cada flag RMA (índice parcial no SQL)
  @@map("tipos_movimentacao")
}

/// BOM 1 nível: componentes do produto acabado
model ProdutoComponente {
  id             String  @id @default(uuid()) @db.Uuid
  produtoPaiId   String  @map("produto_pai_id") @db.Uuid
  produtoFilhoId String  @map("produto_filho_id") @db.Uuid
  /// Quantidade do filho por 1 unidade do pai
  quantidade     Decimal @db.Decimal(12, 4)
  /// true = estrutura apenas (não movimenta estoque na baixa pela árvore)
  fantasma       Boolean @default(false)
  produtoPai     Produto @relation("BomPai", fields: [produtoPaiId], references: [id], onDelete: Cascade)
  produtoFilho   Produto @relation("BomFilho", fields: [produtoFilhoId], references: [id], onDelete: Restrict)

  @@unique([produtoPaiId, produtoFilhoId], name: "uniq_bom_pai_filho")
  @@index([produtoPaiId])
  @@index([produtoFilhoId])
  @@map("produto_componentes")
}

model Estoque {
  id           String   @id @default(uuid()) @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  filialId     String   @map("filial_id") @db.Uuid
  saldoAtual   Decimal  @default(0) @map("saldo_atual") @db.Decimal(12, 4)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  filial       Filial   @relation(fields: [filialId], references: [id], onDelete: Restrict)

  @@unique([produtoId, filialId], name: "uniq_produto_filial")
  @@index([produtoId])
  @@index([filialId])
  @@map("estoques")
}

model Movimentacao {
  id                  String           @id @default(uuid()) @db.Uuid
  produtoId           String           @map("produto_id") @db.Uuid
  tipoId              String           @map("tipo_id") @db.Uuid
  usuarioId           String           @map("usuario_id") @db.Uuid
  clienteId           String?          @map("cliente_id") @db.Uuid
  /// Estoque afetado (ENTRADA/SAIDA) ou origem (TRANSFERENCIA)
  filialId            String           @map("filial_id") @db.Uuid
  /// Estoque destino — só TRANSFERENCIA
  filialDestinoId     String?          @map("filial_destino_id") @db.Uuid
  /// Legado montagem ENTRADA; na baixa atual os componentes saem do filialId
  filialComponentesId String?          @map("filial_componentes_id") @db.Uuid
  quantidade          Decimal          @db.Decimal(12, 4)
  precoUnitario       Decimal          @map("preco_unitario") @db.Decimal(12, 2)
  /// ENTRADA | SAIDA | TRANSFERENCIA
  operacao            String           @db.VarChar(20)
  observacao          String?          @db.Text
  /// Número da NF (lançamentos com cliente/fornecedor)
  notaFiscalNumero    String?          @map("nota_fiscal_numero") @db.VarChar(60)
  /// Path relativo /uploads/notas-fiscais/...
  notaFiscalArquivo   String?          @map("nota_fiscal_arquivo") @db.VarChar(255)
  /// E-mails para alertas de retorno (quando tipo.geraAlertaRetorno)
  alertaEmails        Json             @default("[]") @map("alerta_emails")
  /// Retorno vinculado à saída (demo/comodato)
  movimentacaoOrigemId String?         @map("movimentacao_origem_id") @db.Uuid
  /// Agrupa linhas do mesmo lançamento multi-SKU (ENTRADA/SAIDA)
  grupoLancamentoId String?        @map("grupo_lancamento_id") @db.Uuid
  /// SAIDA/envio pai que originou este consumo de componente da árvore
  movimentacaoMontagemId String?       @map("movimentacao_montagem_id") @db.Uuid
  status              String           @default("CONCLUIDO") @db.VarChar(20)
  estornoDeId         String?          @map("estorno_de_id") @db.Uuid
  transferenciaItemId String?          @map("transferencia_item_id") @db.Uuid
  dataMovimento       DateTime         @default(now()) @map("data_movimento") @db.Timestamptz
  produto             Produto          @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  tipo                TipoMovimentacao @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  usuario             Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  cliente             Cliente?         @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  filial              Filial           @relation("MovFilial", fields: [filialId], references: [id], onDelete: Restrict)
  filialDestino       Filial?          @relation("MovFilialDestino", fields: [filialDestinoId], references: [id], onDelete: Restrict)
  filialComponentes   Filial?          @relation("MovFilialComponentes", fields: [filialComponentesId], references: [id], onDelete: Restrict)
  estornoDe           Movimentacao?    @relation("Estorno", fields: [estornoDeId], references: [id])
  estornos            Movimentacao[]   @relation("Estorno")
  movimentacaoOrigem  Movimentacao?    @relation("RetornoVinculo", fields: [movimentacaoOrigemId], references: [id], onDelete: Restrict)
  retornos            Movimentacao[]   @relation("RetornoVinculo")
  montagemPai         Movimentacao?    @relation("Montagem", fields: [movimentacaoMontagemId], references: [id], onDelete: Restrict)
  consumosMontagem    Movimentacao[]   @relation("Montagem")
  transferenciaItem   TransferenciaItem? @relation(fields: [transferenciaItemId], references: [id])
  /// Séries informadas no lançamento PENDENTE (aplicadas na aprovação)
  seriesInformadas    Json             @default("[]") @map("series_informadas")
  alertasRetorno      AlertaRetornoAgenda[]
  anexos              MovimentacaoAnexo[]
  series              MovimentacaoSerie[]
  rmaItensEntrada     RmaItem[] @relation("RmaItemEntrada")
  rmaItensSaida       RmaItem[] @relation("RmaItemSaida")
  rmaItensDescarte    RmaItem[] @relation("RmaItemDescarte")

  @@index([produtoId])
  @@index([filialId])
  @@index([filialDestinoId])
  @@index([filialComponentesId])
  @@index([dataMovimento])
  @@index([clienteId])
  @@index([status])
  @@index([movimentacaoOrigemId])
  @@index([movimentacaoMontagemId])
  @@index([grupoLancamentoId])
  @@index([notaFiscalNumero])
  @@map("movimentacoes")
}

/// Anexos tipados (termo comodato, etc.). NF principal permanece em Movimentacao.
model MovimentacaoAnexo {
  id             String       @id @default(uuid()) @db.Uuid
  movimentacaoId String       @map("movimentacao_id") @db.Uuid
  /// NOTA_FISCAL | TERMO_COMODATO | OUTRO
  tipo           String       @db.VarChar(40)
  arquivo        String       @db.VarChar(255)
  label          String?      @db.VarChar(120)
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)

  @@index([movimentacaoId])
  @@map("movimentacao_anexos")
}

/// Agendas de alerta de retorno (demo/comodato) — disparo por job diário
model AlertaRetornoAgenda {
  id             String       @id @default(uuid()) @db.Uuid
  movimentacaoId String       @map("movimentacao_id") @db.Uuid
  dias           Int
  agendadoPara   DateTime     @map("agendado_para") @db.Date
  emailsDestino  String       @map("emails_destino") @db.Text
  enviadoEm      DateTime?    @map("enviado_em") @db.Timestamptz
  canceladoEm    DateTime?    @map("cancelado_em") @db.Timestamptz
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)

  @@unique([movimentacaoId, dias])
  @@index([agendadoPara, enviadoEm, canceladoEm])
  @@map("alerta_retorno_agendas")
}

model Transferencia {
  id              String             @id @default(uuid()) @db.Uuid
  origemFilialId  String             @map("origem_filial_id") @db.Uuid
  destinoFilialId String             @map("destino_filial_id") @db.Uuid
  status          String             @db.VarChar(20)
  /// IMEDIATO | AGUARDAR_RECEBIMENTO — usado ao aprovar PENDENTE_APROVACAO
  creditoDestino  String?            @map("credito_destino") @db.VarChar(30)
  guiaTransporte  String?            @map("guia_transporte") @db.VarChar(120)
  /// Número da NF / documento da carga (opcional)
  notaFiscalNumero String?           @map("nota_fiscal_numero") @db.VarChar(60)
  observacao      String?            @db.Text
  motivoRejeicao  String?            @map("motivo_rejeicao") @db.Text
  criadoPorId     String             @map("criado_por_id") @db.Uuid
  criadoEm        DateTime           @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz
  origemFilial    Filial             @relation("Origem", fields: [origemFilialId], references: [id])
  destinoFilial   Filial             @relation("Destino", fields: [destinoFilialId], references: [id])
  criadoPor       Usuario            @relation(fields: [criadoPorId], references: [id])
  itens           TransferenciaItem[]
  anexos          TransferenciaAnexo[]

  @@index([status])
  @@index([notaFiscalNumero])
  @@map("transferencias")
}

/// Anexos da carga (NF, laudo, outros documentos)
model TransferenciaAnexo {
  id              String        @id @default(uuid()) @db.Uuid
  transferenciaId String        @map("transferencia_id") @db.Uuid
  /// NOTA_FISCAL | LAUDO | OUTRO
  tipo            String        @db.VarChar(40)
  arquivo         String        @db.VarChar(255)
  label           String?       @db.VarChar(120)
  criadoEm        DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  @@index([transferenciaId])
  @@map("transferencia_anexos")
}

model TransferenciaItem {
  id               String         @id @default(uuid()) @db.Uuid
  transferenciaId  String         @map("transferencia_id") @db.Uuid
  produtoId        String         @map("produto_id") @db.Uuid
  qtdEnviada       Decimal        @map("qtd_enviada") @db.Decimal(12, 4)
  qtdRecebida      Decimal?       @map("qtd_recebida") @db.Decimal(12, 4)
  /// Obrigatória quando qtdRecebida ≠ qtdEnviada
  justificativaDivergencia String? @map("justificativa_divergencia") @db.Text
  transferencia    Transferencia  @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  produto          Produto        @relation(fields: [produtoId], references: [id])
  movimentacoes    Movimentacao[]
  series           TransferenciaItemSerie[]

  @@map("transferencia_itens")
}

/// Unidade física rastreável (1 série = 1 unidade) quando Produto.controlaSerie
model UnidadeSerie {
  id           String   @id @default(uuid()) @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  numeroSerie  String   @map("numero_serie") @db.VarChar(80)
  /// Filial atual quando EM_ESTOQUE; null em EM_TRANSITO/SAIDO
  filialId     String?  @map("filial_id") @db.Uuid
  /// EM_ESTOQUE | EM_TRANSITO | SAIDO
  status       String   @db.VarChar(20)
  clienteId    String?  @map("cliente_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  filial       Filial?  @relation(fields: [filialId], references: [id], onDelete: Restrict)
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  movimentacoes MovimentacaoSerie[]
  transferenciaItens TransferenciaItemSerie[]
  rmaItens      RmaItem[] @relation("RmaItemSerieOriginal")
  rmaItensSubstituicao RmaItem[] @relation("RmaItemSerieSubstituicao")

  @@unique([produtoId, numeroSerie], name: "uniq_produto_serie")
  @@index([produtoId, status])
  @@index([filialId, status])
  @@index([numeroSerie])
  @@map("unidades_serie")
}

/// Sequencial anual por produto para geração automática de séries
model ContadorSerie {
  id         String  @id @default(uuid()) @db.Uuid
  produtoId  String  @map("produto_id") @db.Uuid
  ano        Int
  sequencial Int     @default(0)
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, ano])
  @@index([produtoId])
  @@map("contador_series")
}

/// Formato / opções de geração automática por produto
model ConfiguracaoSerie {
  id                String  @id @default(uuid()) @db.Uuid
  produtoId         String  @unique @map("produto_id") @db.Uuid
  /// Ex.: {codigo}{ano2}{seq4} ou {codigo}-{ano2}-{seq4}
  formato           String  @default("{codigo}{ano2}{seq4}") @db.VarChar(80)
  geracaoAutomatica Boolean @default(true) @map("geracao_automatica")
  tamanhoSequencial Int     @default(4) @map("tamanho_sequencial")
  prefixoFixo       String? @map("prefixo_fixo") @db.VarChar(20)
  sufixoFixo        String? @map("sufixo_fixo") @db.VarChar(20)
  reiniciarAnual    Boolean @default(true) @map("reiniciar_anual")
  produto           Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("configuracao_series")
}

/// Lote alocado no contador (antes do lançamento criar UnidadeSerie)
model SerieAlocacao {
  id                 String   @id @default(uuid()) @db.Uuid
  produtoId          String   @map("produto_id") @db.Uuid
  usuarioId          String   @map("usuario_id") @db.Uuid
  ano                Int
  sequencialInicial  Int      @map("sequencial_inicial")
  sequencialFinal    Int      @map("sequencial_final")
  /// string[]
  series             Json
  /// PENDENTE | CONFIRMADA | CANCELADA
  status             String   @default("PENDENTE") @db.VarChar(20)
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz
  produto            Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([produtoId, status])
  @@index([usuarioId, status])
  @@map("serie_alocacoes")
}

model MovimentacaoSerie {
  id             String       @id @default(uuid()) @db.Uuid
  movimentacaoId String       @map("movimentacao_id") @db.Uuid
  unidadeSerieId String       @map("unidade_serie_id") @db.Uuid
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id], onDelete: Cascade)
  unidadeSerie   UnidadeSerie @relation(fields: [unidadeSerieId], references: [id], onDelete: Restrict)

  @@unique([movimentacaoId, unidadeSerieId], name: "uniq_mov_serie")
  @@index([unidadeSerieId])
  @@map("movimentacao_series")
}

model TransferenciaItemSerie {
  id                 String           @id @default(uuid()) @db.Uuid
  transferenciaItemId String          @map("transferencia_item_id") @db.Uuid
  unidadeSerieId     String           @map("unidade_serie_id") @db.Uuid
  enviado            Boolean          @default(true)
  /// null até conferência; true = chegou no destino; false = não chegou (volta à origem)
  recebido           Boolean?
  transferenciaItem  TransferenciaItem @relation(fields: [transferenciaItemId], references: [id], onDelete: Cascade)
  unidadeSerie       UnidadeSerie     @relation(fields: [unidadeSerieId], references: [id], onDelete: Restrict)

  @@unique([transferenciaItemId, unidadeSerieId], name: "uniq_transf_item_serie")
  @@index([unidadeSerieId])
  @@map("transferencia_item_series")
}

model ConfiguracaoAlerta {
  id            String            @id @default(uuid()) @db.Uuid
  evento        String            @db.VarChar(60)
  ativo         Boolean           @default(true)
  canalEmail    Boolean           @default(true) @map("canal_email")
  canalPush     Boolean           @default(false) @map("canal_push")
  destinatarios String            @db.Text
  tipoId        String?           @map("tipo_id") @db.Uuid
  descricao     String?           @db.Text
  tipo          TipoMovimentacao? @relation(fields: [tipoId], references: [id])

  @@map("configuracoes_alertas")
}

/// Inbox in-app (F9.1) — e-mail é canal opcional via NotificationService
model Notificacao {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tipo      String   @db.VarChar(60)
  titulo    String   @db.VarChar(150)
  mensagem  String   @db.Text
  lida      Boolean  @default(false)
  meta      Json     @default("{}")
  /// Chave para dedup (usuário+tipo+chave em janela curta)
  dedupeKey String?  @map("dedupe_key") @db.VarChar(200)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm(sort: Desc)])
  @@index([usuarioId, lida])
  @@index([usuarioId, tipo, dedupeKey, criadoEm])
  @@map("notificacoes")
}

/// Templates editáveis de e-mail transacional (Admin). Placeholders {{var}}.
model EmailTemplate {
  type         String   @id @db.VarChar(60)
  subject      String   @db.VarChar(200)
  bodyText     String   @map("body_text") @db.Text
  preheader    String?  @db.VarChar(200)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz

  @@map("email_templates")
}

/// Processo RMA (financeiro + estoque dedicado)
model RmaProcesso {
  id                       String     @id @default(uuid()) @db.Uuid
  clienteId                String     @map("cliente_id") @db.Uuid
  /// Estoque RMA (filial sigla RMA)
  filialId                 String     @map("filial_id") @db.Uuid
  /// ABERTO | FECHADO | CANCELADO
  status                   String     @default("ABERTO") @db.VarChar(20)
  nfEntradaNumero          String?    @map("nf_entrada_numero") @db.VarChar(60)
  nfSaidaNumero            String?    @map("nf_saida_numero") @db.VarChar(60)
  /// null = ainda não informado; true/false = Sim/Não
  cobrou                   Boolean?
  valorCobrado             Decimal?   @map("valor_cobrado") @db.Decimal(12, 2)
  nfCobrancaNumero         String?    @map("nf_cobranca_numero") @db.VarChar(60)
  observacao               String?    @db.Text
  /// Data civil (AAAA-MM-DD) limite para concluir a manutenção dos equipamentos
  prazoManutencao          DateTime?  @map("prazo_manutencao") @db.Date
  /// Usuário comercial responsável pela aprovação com o cliente (snapshot na abertura)
  responsavelComercialId   String?    @map("responsavel_comercial_id") @db.Uuid
  criadoPorId              String     @map("criado_por_id") @db.Uuid
  criadoEm                 DateTime   @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm             DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz
  cliente                  Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  filial                   Filial     @relation(fields: [filialId], references: [id], onDelete: Restrict)
  criadoPor                Usuario    @relation("RmaCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  responsavelComercial     Usuario?   @relation("RmaResponsavelComercial", fields: [responsavelComercialId], references: [id], onDelete: Restrict)
  itens                    RmaItem[]
  anexos                   RmaAnexo[]
  destinatarios            RmaDestinatario[]

  @@index([clienteId])
  @@index([filialId])
  @@index([status])
  @@index([criadoEm])
  @@index([responsavelComercialId])
  @@index([nfEntradaNumero])
  @@index([nfSaidaNumero])
  @@index([nfCobrancaNumero])
  @@index([prazoManutencao])
  @@map("rma_processos")
}

/// Quem recebe sino/e-mail deste processo RMA (snapshot na criação + extras)
model RmaDestinatario {
  id         String      @id @default(uuid()) @db.Uuid
  processoId String      @map("processo_id") @db.Uuid
  usuarioId  String      @map("usuario_id") @db.Uuid
  /// GLOBAL = veio do tick RMA_ABERTO · MANUAL = incluído neste processo
  origem     String      @default("MANUAL") @db.VarChar(20)
  criadoEm   DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  processo   RmaProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([processoId, usuarioId])
  @@index([usuarioId])
  @@map("rma_destinatarios")
}

model RmaItem {
  id              String        @id @default(uuid()) @db.Uuid
  processoId      String        @map("processo_id") @db.Uuid
  produtoId       String        @map("produto_id") @db.Uuid
  unidadeSerieId  String?       @map("unidade_serie_id") @db.Uuid
  quantidade      Decimal       @db.Decimal(12, 4)
  /// ABERTO | EM_ESTOQUE | SEM_MANUTENCAO | DEVOLVIDO | DESCARTADO | CANCELADO
  status          String        @default("ABERTO") @db.VarChar(20)
  /// AGUARDANDO_RECEBIMENTO | AGUARDANDO_ORCAMENTO | AGUARDANDO_APROVACAO | AGUARDANDO_MANUTENCAO | AGUARDANDO_LIBERACAO | NAO_APROVADO | AGUARDANDO_ENVIO | FINALIZADO
  /// (AGUARDANDO_LAUDO é legado — migrado para AGUARDANDO_RECEBIMENTO)
  etapa           String        @default("AGUARDANDO_RECEBIMENTO") @db.VarChar(30)
  aprovacaoEm     DateTime?     @map("aprovacao_em") @db.Timestamptz
  aprovacaoPorId  String?       @map("aprovacao_por_id") @db.Uuid
  aprovacaoObs    String?       @map("aprovacao_obs") @db.Text
  /// Cobrança de manutenção deste item (independente dos demais da nota)
  cobrou          Boolean?
  valorCobrado    Decimal?      @map("valor_cobrado") @db.Decimal(12, 2)
  nfCobrancaNumero String?      @map("nf_cobranca_numero") @db.VarChar(60)
  movEntradaId    String?       @map("mov_entrada_id") @db.Uuid
  movSaidaId      String?       @map("mov_saida_id") @db.Uuid
  movDescarteId   String?       @map("mov_descarte_id") @db.Uuid
  /// Série boa enviada ao cliente na troca (substitui a unidadeSerie ruim)
  unidadeSerieSubstituicaoId String? @map("unidade_serie_substituicao_id") @db.Uuid
  observacao      String?       @db.Text
  processo        RmaProcesso   @relation(fields: [processoId], references: [id], onDelete: Cascade)
  produto         Produto       @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  unidadeSerie    UnidadeSerie? @relation("RmaItemSerieOriginal", fields: [unidadeSerieId], references: [id], onDelete: SetNull)
  unidadeSerieSubstituicao UnidadeSerie? @relation("RmaItemSerieSubstituicao", fields: [unidadeSerieSubstituicaoId], references: [id], onDelete: SetNull)
  aprovacaoPor    Usuario?      @relation("RmaItemAprovacaoPor", fields: [aprovacaoPorId], references: [id], onDelete: SetNull)
  movEntrada      Movimentacao? @relation("RmaItemEntrada", fields: [movEntradaId], references: [id], onDelete: SetNull)
  movSaida        Movimentacao? @relation("RmaItemSaida", fields: [movSaidaId], references: [id], onDelete: SetNull)
  movDescarte     Movimentacao? @relation("RmaItemDescarte", fields: [movDescarteId], references: [id], onDelete: SetNull)
  anexos          RmaAnexo[]
  checklistExecucoes RmaChecklistExecucao[]
  diagnostico     RmaDiagnostico?
  manutencaoPlano RmaManutencaoPlano?
  orcamento       RmaOrcamento?

  @@index([processoId])
  @@index([produtoId])
  @@index([status])
  @@index([etapa])
  @@index([unidadeSerieSubstituicaoId])
  @@index([nfCobrancaNumero])
  @@map("rma_itens")
}

model RmaAnexo {
  id            String      @id @default(uuid()) @db.Uuid
  processoId    String      @map("processo_id") @db.Uuid
  /// Laudo por produto/série; null = anexo do processo (NF etc.)
  itemId        String?     @map("item_id") @db.Uuid
  /// LAUDO | NF_ENTRADA | NF_SAIDA | NF_COBRANCA | OUTRO
  tipo          String      @db.VarChar(40)
  /// Path público: /uploads/rma/{processoId}/atual/... ou .../historico/...
  arquivo       String      @db.VarChar(255)
  label         String?     @db.VarChar(120)
  /// false = substituído (mantido para consulta / auditoria)
  ativo         Boolean     @default(true)
  substituidoEm DateTime?   @map("substituido_em") @db.Timestamptz
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  processo      RmaProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)
  item          RmaItem?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([processoId])
  @@index([itemId])
  @@index([processoId, tipo, ativo])
  @@map("rma_anexos")
}

/// Template de checklist RMA por produto (SKU) — RECEBIMENTO ou LIBERACAO
model RmaChecklistTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  produtoId String   @map("produto_id") @db.Uuid
  /// RECEBIMENTO | LIBERACAO
  tipo      String   @db.VarChar(20)
  nome      String   @db.VarChar(120)
  ativo     Boolean  @default(true)
  versao    Int      @default(1)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  itens     RmaChecklistTemplateItem[]
  execucoes RmaChecklistExecucao[]

  /// Unique parcial no DB: (produto_id, tipo) WHERE ativo = true
  /// (ver migration 20260814120000 — Prisma não modela partial unique)
  @@index([produtoId, tipo])
  @@index([tipo, ativo])
  @@map("rma_checklist_templates")
}

model RmaChecklistTemplateItem {
  id           String @id @default(uuid()) @db.Uuid
  templateId   String @map("template_id") @db.Uuid
  ordem        Int    @default(0)
  codigo       String @db.VarChar(40)
  titulo       String @db.VarChar(200)
  ajuda        String? @db.Text
  /// SIM_NAO | TEXTO | OPCAO | FOTO
  tipoCampo    String @map("tipo_campo") @db.VarChar(20)
  obrigatorio  Boolean @default(true)
  opcoesJson   Json?  @map("opcoes_json")
  /// Se resposta igual a este valor, exige ao menos 1 foto
  exigeFotoSe  String? @map("exige_foto_se") @db.VarChar(40)
  template     RmaChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  respostas    RmaChecklistResposta[]

  @@index([templateId, ordem])
  @@map("rma_checklist_template_itens")
}

model RmaChecklistExecucao {
  id              String   @id @default(uuid()) @db.Uuid
  rmaItemId       String   @map("rma_item_id") @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  /// RECEBIMENTO | LIBERACAO
  tipo            String   @db.VarChar(20)
  /// EM_PREENCHIMENTO | CONCLUIDO
  status          String   @default("EM_PREENCHIMENTO") @db.VarChar(20)
  preenchidoPorId String?  @map("preenchido_por_id") @db.Uuid
  concluidoEm     DateTime? @map("concluido_em") @db.Timestamptz
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  rmaItem         RmaItem  @relation(fields: [rmaItemId], references: [id], onDelete: Cascade)
  template        RmaChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  preenchidoPor   Usuario? @relation("RmaChecklistPreenchidoPor", fields: [preenchidoPorId], references: [id], onDelete: SetNull)
  respostas       RmaChecklistResposta[]

  @@unique([rmaItemId, tipo])
  @@index([templateId])
  @@index([status])
  @@map("rma_checklist_execucoes")
}

model RmaChecklistResposta {
  id             String @id @default(uuid()) @db.Uuid
  execucaoId     String @map("execucao_id") @db.Uuid
  templateItemId String @map("template_item_id") @db.Uuid
  valorTexto     String? @map("valor_texto") @db.Text
  valorBool      Boolean? @map("valor_bool")
  fotos          Json   @default("[]")
  execucao       RmaChecklistExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  templateItem   RmaChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)

  @@unique([execucaoId, templateItemId])
  @@map("rma_checklist_respostas")
}

model RmaDiagnostico {
  id                 String   @id @default(uuid()) @db.Uuid
  rmaItemId          String   @unique @map("rma_item_id") @db.Uuid
  resumoProblema     String   @map("resumo_problema") @db.Text
  observacaoTecnica  String?  @map("observacao_tecnica") @db.Text
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  rmaItem            RmaItem  @relation(fields: [rmaItemId], references: [id], onDelete: Cascade)

  @@map("rma_diagnosticos")
}

model RmaManutencaoPlano {
  id           String   @id @default(uuid()) @db.Uuid
  rmaItemId    String   @unique @map("rma_item_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  rmaItem      RmaItem  @relation(fields: [rmaItemId], references: [id], onDelete: Cascade)
  servicos     RmaManutencaoServico[]
  pecas        RmaManutencaoPeca[]

  @@map("rma_manutencao_planos")
}

model RmaManutencaoServico {
  id           String @id @default(uuid()) @db.Uuid
  planoId      String @map("plano_id") @db.Uuid
  ordem        Int    @default(0)
  descricao    String @db.VarChar(300)
  /// Tempo gasto pelo técnico (minutos)
  tempoMinutos Int?   @map("tempo_minutos")
  plano        RmaManutencaoPlano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([planoId, ordem])
  @@map("rma_manutencao_servicos")
}

model RmaManutencaoPeca {
  id          String  @id @default(uuid()) @db.Uuid
  planoId     String  @map("plano_id") @db.Uuid
  produtoId   String  @map("produto_id") @db.Uuid
  quantidade  Decimal @db.Decimal(12, 4)
  motivo      String? @db.VarChar(300)
  plano       RmaManutencaoPlano @relation(fields: [planoId], references: [id], onDelete: Cascade)
  produto     Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([planoId])
  @@index([produtoId])
  @@map("rma_manutencao_pecas")
}

model RmaOrcamento {
  id                   String   @id @default(uuid()) @db.Uuid
  rmaItemId            String   @unique @map("rma_item_id") @db.Uuid
  /// RASCUNHO | ENVIADO | APROVADO | RECUSADO
  status               String   @default("RASCUNHO") @db.VarChar(20)
  maoDeObra            Decimal  @default(0) @map("mao_de_obra") @db.Decimal(12, 2)
  desconto             Decimal  @default(0) @db.Decimal(12, 2)
  observacaoComercial  String?  @map("observacao_comercial") @db.Text
  enviadoEm            DateTime? @map("enviado_em") @db.Timestamptz
  aprovadoEm           DateTime? @map("aprovado_em") @db.Timestamptz
  aprovadoPorId        String?  @map("aprovado_por_id") @db.Uuid
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  rmaItem              RmaItem  @relation(fields: [rmaItemId], references: [id], onDelete: Cascade)
  aprovadoPor          Usuario? @relation("RmaOrcamentoAprovadoPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  linhas               RmaOrcamentoLinha[]

  @@index([status])
  @@map("rma_orcamentos")
}

model RmaOrcamentoLinha {
  id            String  @id @default(uuid()) @db.Uuid
  orcamentoId   String  @map("orcamento_id") @db.Uuid
  descricao     String  @db.VarChar(300)
  produtoId     String? @map("produto_id") @db.Uuid
  quantidade    Decimal @db.Decimal(12, 4)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  /// SERVICO | PECA | EXTRA
  origem        String  @default("EXTRA") @db.VarChar(20)
  /// Snapshot do tempo do plano (minutos), para PDF estável
  tempoMinutos  Int?    @map("tempo_minutos")
  orcamento     RmaOrcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto       Produto? @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([orcamentoId])
  @@index([produtoId])
  @@map("rma_orcamento_linhas")
}

/// Pedido de venda espelhado do eGestor (somente leitura na origem)
model PedidoVenda {
  id                 String   @id @default(uuid()) @db.Uuid
  egestorCodigo      Int      @unique @map("egestor_codigo")
  nomeContato        String   @map("nome_contato") @db.VarChar(150)
  codContato         Int?     @map("cod_contato")
  dtVenda            DateTime @map("dt_venda") @db.Date
  situacao           Int
  situacaoOs         String?  @map("situacao_os") @db.VarChar(40)
  valorTotal         Decimal  @default(0) @map("valor_total") @db.Decimal(12, 2)
  /// ABERTO | SEPARADO
  status             String   @default("ABERTO") @db.VarChar(20)
  filialAcabadoId    String?  @map("filial_acabado_id") @db.Uuid
  separadoEm         DateTime? @map("separado_em") @db.Timestamptz
  separadoPorId      String?  @map("separado_por_id") @db.Uuid
  grupoLancamentoId  String?  @map("grupo_lancamento_id") @db.Uuid
  syncedAt           DateTime @default(now()) @map("synced_at") @db.Timestamptz
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm       DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  filialAcabado      Filial?  @relation(fields: [filialAcabadoId], references: [id], onDelete: SetNull)
  separadoPor        Usuario? @relation("PedidoSeparadoPor", fields: [separadoPorId], references: [id], onDelete: SetNull)
  itens              PedidoVendaItem[]
  destinatarios      PedidoVendaDestinatario[]

  @@index([status])
  @@index([dtVenda])
  @@index([grupoLancamentoId])
  @@map("pedidos_venda")
}

model PedidoVendaItem {
  id                String      @id @default(uuid()) @db.Uuid
  pedidoId          String      @map("pedido_id") @db.Uuid
  egestorItemCodigo Int?        @map("egestor_item_codigo")
  codigoProprio     String      @map("codigo_proprio") @db.VarChar(80)
  descricao         String      @db.VarChar(200)
  quantidade        Decimal     @db.Decimal(12, 4)
  produtoId         String?     @map("produto_id") @db.Uuid
  pedido            PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto           Produto?    @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@unique([pedidoId, egestorItemCodigo])
  @@index([pedidoId])
  @@index([produtoId])
  @@map("pedido_venda_itens")
}

model PedidoVendaDestinatario {
  id        String      @id @default(uuid()) @db.Uuid
  pedidoId  String      @map("pedido_id") @db.Uuid
  usuarioId String      @map("usuario_id") @db.Uuid
  pedido    PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([pedidoId, usuarioId])
  @@index([usuarioId])
  @@map("pedido_venda_destinatarios")
}
