# =============================================================================
# TEEP Estoque — .env.production (exemplo documentado)
# =============================================================================
#
# Uso: cp deploy/env.production.example .env.production && ./scripts/compose-prod.sh up -d --build
# Senha SMTP com $: deploy/smtp.env.example → .smtp.env (não use SMTP_PASS aqui).
# Guia: docs/INSTALACAO.md · suporte: docs/INSTALACAO-SUPORTE.md (TEEP_SUORTE=1)
# =============================================================================


# -----------------------------------------------------------------------------
# Domínios (DNS A/AAAA → IP do VPS) — Caddy emite HTTPS (Let's Encrypt)
# -----------------------------------------------------------------------------
# WEB_HOST → site Next.js (login, cadastros, lançamentos)
# API_HOST → Express + Socket.io + /uploads
WEB_HOST=estoque.teep.com.br
API_HOST=api.estoque.teep.com.br


# -----------------------------------------------------------------------------
# URLs públicas (build do Next + CORS da API)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* entram no bundle do browser no build Docker do `web`.
# CORS_ORIGIN deve ser a origem do front (mesmo host do WEB_HOST com https).
NEXT_PUBLIC_APP_URL=https://estoque.teep.com.br
NEXT_PUBLIC_API_URL=https://api.estoque.teep.com.br
CORS_ORIGIN=https://estoque.teep.com.br


# -----------------------------------------------------------------------------
# Postgres (container `postgres` — portas NÃO publicadas na internet)
# -----------------------------------------------------------------------------
# Usado para montar DATABASE_URL dentro da API.
POSTGRES_USER=teep
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=estoque_teep


# -----------------------------------------------------------------------------
# JWT (obrigatório — API recusa subir com secret fraco em production)
# -----------------------------------------------------------------------------
# Gere strings aleatórias ≥32 chars (sem "change-me").
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d


# -----------------------------------------------------------------------------
# Seed no boot do container API
# -----------------------------------------------------------------------------
# SEED_ON_START=1 → migrate + seed (admin/tipos/filiais) no primeiro boot.
# Depois volte para 0 e recomece o serviço api (evita reseed a cada restart).
SEED_ON_START=0
SEED_ADMIN_EMAIL=admin@teep.com.br
SEED_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# SMTP — senha em .smtp.env (deploy/smtp.env.example), não SMTP_PASS aqui
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_SECURE=0
# EMAIL_FROM_TRANSACTIONAL=TEEP Estoque <noreply@teep.com.br>
# EMAIL_REPLY_TO=suporte@teep.com.br
# EMAIL_SUPPORT=suporte@teep.com.br
# FRONTEND_URL=https://estoque.teep.com.br


# -----------------------------------------------------------------------------
# Assistente LLM no Dashboard (opcional — F14)
# -----------------------------------------------------------------------------
# ASSISTENTE_LLM_ENABLED=0
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# PDF (Puppeteer) — exportar Saldos no Dashboard
# -----------------------------------------------------------------------------
# Imagem Alpine da API já instala Chromium e define o path padrão.
# Override só se necessário:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# -----------------------------------------------------------------------------
# RMA — defaults de filiais (opcional, Fase D)
# -----------------------------------------------------------------------------
# Sem estas vars: API resolve por sigla RMA/DESC e lista estoques operacionais.
# RMA_FILIAL_PREPARACAO_ID=
# RMA_FILIAL_DESCARTE_ID=
# RMA_FILIAIS_ORIGEM_TROCA_IDS=

# eGestor (pedidos — somente leitura)
# Obrigatório no .env.production e listado em docker-compose.prod.yml → api.environment
EGESTOR_PERSONAL_TOKEN=
# EGESTOR_BASE_URL=https://v4.egestor.com.br/api
# EGESTOR_SYNC=0
# EGESTOR_SYNC_INTERVAL_MS=300000
# EGESTOR_SYNC_DT_INI=2026-08-01
